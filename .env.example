# Copy to `.env` and fill in real values. Never commit `.env`.
# Secrets live in untracked `.env` only; they are never baked into the image.
PORT=8000
ARGUS_OFFLINE=0
META_API_KEY=
ARGUS_DB_PATH=data/argus.db
# Long-lived chat memory (Mem0 hosted API). Empty key = memory disabled;
# the room works without it, and ARGUS_OFFLINE=1 never egresses.
MEM0_API_KEY=
MEM0_USER_ID=operator

# --- Alert delivery (webhook channels are managed in-app at /api/channels) ---
# Public base URL used in delivered payloads' report links.
ARGUS_PUBLIC_URL=https://argus.techa.pro

# --- GitHub sign-in (POST/DELETE pipeline actions are gated when armed) ---
# Create an OAuth App at https://github.com/settings/developers with
# Homepage URL = ARGUS_PUBLIC_URL and callback = <ARGUS_PUBLIC_URL>/api/auth/callback.
# Keys absent => the gate is off and the room behaves as before.
ARGUS_GITHUB_CLIENT_ID=
ARGUS_GITHUB_CLIENT_SECRET=
ARGUS_SESSION_SECRET=
# Optional comma-separated allowlist of GitHub logins; empty = any GitHub user.
ARGUS_GITHUB_ADMINS=
